<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ohana_kitchen_display_list" model="ir.ui.view">
        <field name="name">ohana.kitchen.display.list</field>
        <field name="model">ohana.kitchen.display</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
                <field name="category_ids" widget="many2many_tags" optional="show"/>
                <field name="refresh_seconds"/>
                <field name="alert_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ohana_kitchen_display_form" model="ir.ui.view">
        <field name="name">ohana.kitchen.display.form</field>
        <field name="model">ohana.kitchen.display</field>
        <field name="arch" type="xml">
            <form string="Ohana Kitchen Display">
                <header>
                    <button name="action_open_screen" type="object" string="Open Kitchen Screen" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tickets" type="object" class="oe_stat_button" icon="fa-cutlery">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Order Routing">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pos_config_ids" widget="many2many_tags"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="stage_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Screen Behaviour">
                            <field name="refresh_seconds"/>
                            <field name="alert_minutes"/>
                            <field name="sound_enabled"/>
                            <field name="show_product_images"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ohana_kitchen_display" model="ir.actions.act_window">
        <field name="name">Kitchen Displays</field>
        <field name="res_model">ohana.kitchen.display</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
