<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kitchen_screen" name="Ohana Kitchen Display">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <meta name="theme-color" content="#111111"/>
                <title>Ohana Kitchen</title>
                <link rel="icon" type="image/png" href="/ohana_kitchen_display/static/src/img/ohana_logo.png"/>
                <link rel="stylesheet" href="/ohana_kitchen_display/static/src/css/kitchen.css"/>
            </head>
            <body>
                <div id="ohana-kitchen-app" t-att-data-display-id="display.id if display else 0">
                    <header class="kitchen-header">
                        <div class="brand">
                            <img src="/ohana_kitchen_display/static/src/img/ohana_logo.png" alt="Ohana Restaurant"/>
                            <div>
                                <span>Live production</span>
                                <h1 t-esc="display.name if display else 'Ohana Kitchen'"/>
                            </div>
                        </div>
                        <div class="header-actions">
                            <label t-if="len(displays) &gt; 1" class="display-select">
                                <span>Display</span>
                                <select id="display-switcher">
                                    <t t-foreach="displays" t-as="item" t-key="item.id">
                                        <option t-att-value="item.id" t-att-selected="display and item.id == display.id" t-esc="item.name"/>
                                    </t>
                                </select>
                            </label>
                            <div class="connection online" id="connection-state"><span></span> Live</div>
                            <div class="clock" id="kitchen-clock">--:--</div>
                            <a t-if="can_configure" href="/ohana/kitchen/configuration" class="icon-button" title="Kitchen configuration">⚙</a>
                            <button id="fullscreen-button" class="icon-button" type="button" title="Full screen">⛶</button>
                            <a href="/odoo" class="icon-button" title="Return to Odoo">×</a>
                        </div>
                    </header>

                    <main>
                        <div t-if="not display" class="empty-state setup-required">
                            <img src="/ohana_kitchen_display/static/src/img/ohana_logo.png" alt="Ohana Restaurant"/>
                            <h2>Kitchen display setup required</h2>
                            <p>Create a display and assign the Ohana restaurant Point of Sale.</p>
                            <a t-if="can_configure" href="/ohana/kitchen/configuration" class="primary-link">Configure Kitchen Display</a>
                            <a t-else="" href="/odoo" class="primary-link">Return to Odoo</a>
                        </div>
                        <t t-else="">
                            <div class="summary-bar" id="summary-bar">
                                <div><strong id="active-ticket-count">0</strong><span>Active tickets</span></div>
                                <div><strong id="late-ticket-count">0</strong><span>Needs attention</span></div>
                                <div><strong id="updated-ticket-count">0</strong><span>Order updates</span></div>
                                <p id="last-sync">Waiting for orders…</p>
                            </div>
                            <div id="kitchen-board" class="kitchen-board" aria-live="polite"/>
                        </t>
                    </main>
                </div>
                <script type="module" src="/ohana_kitchen_display/static/src/js/kitchen.js"/>
            </body>
        </html>
    </template>
</odoo>
