<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ohana_kitchen" model="ir.module.category">
        <field name="name">Ohana Restaurant</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_ohana_kitchen_display" model="res.groups.privilege">
        <field name="name">Kitchen Display</field>
        <field name="category_id" ref="module_category_ohana_kitchen"/>
    </record>

    <record id="group_ohana_kitchen_user" model="res.groups">
        <field name="name">Ohana Kitchen User</field>
        <field name="privilege_id" ref="privilege_ohana_kitchen_display"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_ohana_kitchen_manager" model="res.groups">
        <field name="name">Ohana Kitchen Manager</field>
        <field name="privilege_id" ref="privilege_ohana_kitchen_display"/>
        <field name="implied_ids" eval="[(4, ref('group_ohana_kitchen_user'))]"/>
    </record>

    <record id="rule_ohana_kitchen_display_company" model="ir.rule">
        <field name="name">Ohana kitchen displays by company</field>
        <field name="model_id" ref="model_ohana_kitchen_display"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ohana_kitchen_user'))]"/>
    </record>

    <record id="rule_ohana_kitchen_ticket_company" model="ir.rule">
        <field name="name">Ohana kitchen tickets by company</field>
        <field name="model_id" ref="model_ohana_kitchen_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ohana_kitchen_user'))]"/>
    </record>
</odoo>
